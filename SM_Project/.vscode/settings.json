    "--query-driver=${env:CUBE_BUNDLE_PATH}/gnu-tools-for-stm32/13.3.1+st.9/bin/arm-none-eabi-g++",
    "--fallback-style=none"
  ],
  "editor.formatOnSave": true,
  "cortex-debug.variableUseNaturalFormat": true
}