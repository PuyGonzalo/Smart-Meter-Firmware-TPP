{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug w/ ST-Link",
      "cwd": "${workspaceFolder}",
      "type": "cortex-debug",
      "executable": "${workspaceFolder}/build/Debug/Smart-Meter-FW-TPP.elf",
      "request": "launch",
      "servertype": "stlink",
      "device": "STM32L031K6Tx",
      "interface": "swd",
      "runToEntryPoint": "main",
      "svdFile": "C:\\ST\\STM32CubeCLT_1.19.0\\STMicroelectronics_CMSIS_SVD\\STM32L0x1.svd",
