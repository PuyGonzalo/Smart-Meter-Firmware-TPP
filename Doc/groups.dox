/**
 * @file groups.dox
 * @brief Doxygen module (group) hierarchy for the Smart Meter firmware.
 *
 * This file only declares the groups. Each source/header assigns its entities
 * to a group with `@addtogroup <id> @{ ... @}` or `@ingroup <id>`.
 */

/* ------------------------------------------------------------------ */
/* Top-level groups                                                    */
/* ------------------------------------------------------------------ */

/**
 * @defgroup app Application modules
 * @brief High-level application logic built on top of the device drivers.
 *
 * These modules implement the device behaviour: talking to the head-end
 * system (HES), encoding/decoding the wire payload, counting water pulses,
 * persisting state and managing low-power sleep.
 */

/**
 * @defgroup drivers Device drivers
 * @brief Hardware- and modem-facing drivers used by the application modules.
 *
 * The drivers hide the details of the cellular modem and the generic AT
 * command transport, exposing a small C API to the application layer.
 */

/* ------------------------------------------------------------------ */
/* Application modules                                                 */
/* ------------------------------------------------------------------ */

/**
 * @defgroup atcom ATCom — HES communication
 * @ingroup app
 * @brief Finite-state machines that exchange messages with the HES.
 *
 * ATCom is split into three cooperating parts:
 * - @ref atcom_registration "Registration FSM" — one-time device enrolment.
 * - @ref atcom_session "Session FSM" — the periodic data exchange.
 * - @ref atcom_udp "UDP context" — brings up the PDP context and UDP socket,
 *   shared by both FSMs.
 *
 * Both FSMs are non-blocking and are driven by repeated calls from the main
 * loop; they share the error-handling policy (exponential backoff, hard reset
 * after N consecutive failures).
 */
    /**
     * @defgroup atcom_registration Registration FSM
     * @ingroup atcom
     * @brief One-time enrolment of the device against the HES.
     */
    /**
     * @defgroup atcom_session Session FSM
     * @ingroup atcom
     * @brief Periodic session: IP announce, HES message dispatch, data reply.
     */
    /**
     * @defgroup atcom_udp UDP context
     * @ingroup atcom
     * @brief PDP-context activation and UDP socket setup shared by both FSMs.
     */

/**
 * @defgroup payload Payload / RLP codec
 * @ingroup app
 * @brief RLP (Recursive Length Prefix) encoder/decoder and message envelope.
 *
 * Provides the on-the-wire encoding used with the HES: a fixed 46-byte
 * envelope header plus an RLP-encoded body carrying OBIS code/value pairs.
 */

/**
 * @defgroup pulsecounter Pulse counter
 * @ingroup app
 * @brief Counts water-meter pulses on PA8 with RTC-based debouncing.
 *
 * The counter is incremented from the PA8 EXTI ISR and keeps working while
 * the MCU is in STOP mode (the RTC is the debounce time base).
 */

/**
 * @defgroup storage Persistent storage
 * @ingroup app
 * @brief Non-volatile storage in the STM32L031 internal Data EEPROM.
 *
 * Persists device credentials, the IMEI and the pulse-count checkpoint across
 * resets and power loss.
 */

/**
 * @defgroup lpm Low-power management
 * @ingroup app
 * @brief STM32L0 STOP-mode entry/exit and IWDG-aware timed sleep.
 */

/* ------------------------------------------------------------------ */
/* Device drivers                                                      */
/* ------------------------------------------------------------------ */

/**
 * @defgroup atcore ATCore — AT command framework
 * @ingroup drivers
 * @brief Generic AT command transport and response parser.
 *
 * ATCore builds AT command strings from descriptors, sends them through a
 * device driver (currently the BG95) and parses the responses. It is the
 * layer the application modules call to run AT commands.
 */

/**
 * @defgroup bg95 Quectel BG95 driver
 * @ingroup drivers
 * @brief Power control and UART/DMA transport for the Quectel BG95 modem.
 *
 * Handles power-on/off sequencing (PWRKEY, STATUS, level shifter), the
 * readiness check (AT alive + SIM + network attach) and DMA-based reception.
 */

/* ------------------------------------------------------------------ */
/* Platform / board support                                            */
/* ------------------------------------------------------------------ */

/**
 * @defgroup platform Platform / board support
 * @brief Hand-written helpers over the STM32L0 peripherals used across the app.
 *
 * Custom peripheral helpers that are not part of the modem stack: a lightweight
 * software-timer module (delay) and RTC helpers (UNIX timestamp, alarms,
 * sub-second ticks and the LSE→LSI failover). The remaining peripheral setup
 * (USART/LPUART, DMA, GPIO, IWDG) is generated by STM32CubeMX.
 */
